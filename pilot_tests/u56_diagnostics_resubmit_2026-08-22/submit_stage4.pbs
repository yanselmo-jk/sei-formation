#!/bin/sh
#PBS -V
#PBS -q normal
#PBS -N sei_u56_diag_stage4
#PBS -A gaussian
#PBS -l select=1:ncpus=1:mpiprocs=1
#PBS -l walltime=30:00:00
# ADR-117. Stage 4 ONLY. Reads irc_forward_recorrect_probe.chk (genuine input, byte-exact
# md5 87a378633c55f4df0021f133943cfe97) -- do not regenerate or truncate it.
set -u
cd "${PBS_O_WORKDIR:-.}/4_irc_recorrect_restart" || exit 1
trap 'echo "[sei] SIGTERM $(date -u +%FT%TZ): stage4 killed before completion" >> stage4_kill.marker; exit 1' TERM
module load gaussian/g16.c01.linda 2>/dev/null || echo '[sei] module load gaussian/g16.c01.linda failed - continuing'
echo "[sei] stage4 start $(date -u +%FT%TZ)"
g16 < irc_recorrect_probe.gjf > irc_recorrect_probe.log 2>&1
rc=$?
echo "[sei] stage4 end $(date -u +%FT%TZ) rc=$rc"
exit $rc

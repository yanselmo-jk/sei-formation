#!/bin/sh
#PBS -V
#PBS -q normal
#PBS -N sei_u56_bplus_reverse_mid_v2
#PBS -A gaussian
#PBS -l select=1:ncpus=64:mpiprocs=1:ompthreads=64
#PBS -l walltime=02:00:00
# B+ terminal optimization, arc-length MIDPOINT start (proposer13 §39.131, 02_METHOD_SPEC.md)
# -- one of the two jobs closing U-56a condition 7's reverse branch, now that Candidate B's
# StepSize hypothesis is CONFIRMED (clean 70-point walk, zero corrector warnings). Starts
# from Point 35 (arc 2.38953) of the returned irc_stepsize_probe.log -- picked by
# guards.bplus_sample_points() and cross-checked in the deck build itself against
# proposer13's independently-derived ruled values (both matched exactly, see manifest_mid.json).
#
# Same route family as the ORIGINAL bplus_reverse_mid.gjf (cpu_machine_pilot_results/
# sei_pilot_work/jobs/U56_RA_scan/bplus_reverse_mid.gjf) -- byte-identical route, verified
# directly: wB97XD/gen, scrf=(pcm,solvent=acetone,read), opt=(loose,maxcycles=100),
# Int(Grid=UltraFine), eps=18.5, charge 0, multiplicity 2 -- only the starting geometry
# differs (Candidate B's new reverse path, not the crashed original 6-point path).
#
# Two separate PBS scripts (this one + submit_bplus_last.pbs), not one combined script:
# same one-job-per-qsub convention as every other staged deck this round (stage3/4,
# candidate A/B/EulerPC/DVV) -- these two optimizations have no sequencing dependency on
# each other (unlike the smoke-then-full tiers), so independent submission/monitoring/kill
# markers is the simpler, more consistent choice, not a special case.
#
# Walltime: MEASURED anchor, not an estimate -- the ORIGINAL bplus_reverse_mid.gjf (same
# route, same job class, same 11-atom system) measured 12.51 core-h consumed (Job cpu time
# 12h30m30.7s) / 14.66 core-h reserved (Elapsed 13m44.7s x 64 cores, 85% efficiency) at 64
# cores -- the RESERVED figure is the one a budget/scheduler cares about. 2h is a >8x margin
# over that measured elapsed time -- generous for a job this cheap and this well-anchored
# (route already smoked by every real production job this round, the lowest-risk deck built
# this whole work item).
#
# Cores come from the deck's own %nprocshared=64 line -- no builder default.
# GAUSS_NPROCSHARED is NOT a Gaussian 16 variable and is deliberately absent here.
set -u
cd "${PBS_O_WORKDIR:-.}" || exit 1
trap 'echo "[sei] SIGTERM $(date -u +%FT%TZ): bplus_mid killed before completion" >> bplus_mid_kill.marker; exit 1' TERM
module load gaussian/g16.c01.linda 2>/dev/null || echo '[sei] module load gaussian/g16.c01.linda failed - continuing'
echo "[sei] bplus_mid start $(date -u +%FT%TZ)"
g16 < bplus_reverse_mid.gjf > bplus_reverse_mid.log 2>&1
rc=$?
echo "[sei] bplus_mid end $(date -u +%FT%TZ) rc=$rc"
exit $rc

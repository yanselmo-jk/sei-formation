#!/bin/sh
#PBS -V
#PBS -q normal
#PBS -N sei_u56_diag_probe5
#PBS -A gaussian
#PBS -l select=1:ncpus=1:mpiprocs=1
#PBS -l walltime=06:00:00
# ADR-115 residual-gap probe. Stage 5 ONLY -- never bundle with stage 3 or 4.
# Geometry: the LAST Input orientation block of U56_RA_scan/irc_forward.log (:30018),
# i.e. the final corrector trial geometry before the IRC gave up -- the true crash
# geometry, which stages 1/2 (arc 1.71, arc 6.83) did NOT probe.
# Cores come from the deck's %nprocshared=1. Do not export GAUSS_NPROCSHARED (not a G16 variable).
set -u
cd "${PBS_O_WORKDIR:-.}/5_ra_crash_geometry" || exit 1
trap 'echo "[sei] SIGTERM $(date -u +%FT%TZ): probe5 killed before completion" >> probe5_kill.marker; exit 1' TERM
module load gaussian/g16.c01.linda 2>/dev/null || echo '[sei] module load gaussian/g16.c01.linda failed - continuing'
echo "[sei] probe5 start $(date -u +%FT%TZ)"
g16 < stability_probe.gjf > stability_probe.log 2>&1
rc=$?
echo "[sei] probe5 end $(date -u +%FT%TZ) rc=$rc"
exit $rc

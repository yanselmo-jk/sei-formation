#!/bin/sh
#PBS -V
#PBS -q normal
#PBS -N sei_u56_bplus_reverse_last_v2
#PBS -A gaussian
#PBS -l select=1:ncpus=64:mpiprocs=1:ompthreads=64
#PBS -l walltime=02:00:00
# B+ terminal optimization, FINAL PATH POINT start (proposer13 §39.131, 02_METHOD_SPEC.md) --
# the other of the two jobs closing U-56a condition 7's reverse branch. Starts from Point 70
# (arc 4.77975, the last point of the 70-point ceiling-truncated walk) of the returned
# irc_stepsize_probe.log -- picked by guards.bplus_sample_points() and cross-checked in the
# deck build itself against proposer13's independently-derived ruled values (both matched
# exactly, see manifest_last.json).
#
# This job's optimized geometry ALSO feeds reactant_match(last) at 0.05 A tolerance
# (guards.REACTANT_MATCH_TOLERANCE_ANG) -- required by condition 7 branch (b)'s full AND-block
# (Ruling 2), not optional and not a separate future job. See this directory's README for the
# exact existing-code instructions to compute both bplus.agreement and reactant_match(last)
# once this job and submit_bplus_mid.pbs have both returned.
#
# Same route family as the ORIGINAL bplus_reverse_last.gjf (cpu_machine_pilot_results/
# sei_pilot_work/jobs/U56_RA_scan/bplus_reverse_last.gjf) -- byte-identical route, verified
# directly: wB97XD/gen, scrf=(pcm,solvent=acetone,read), opt=(loose,maxcycles=100),
# Int(Grid=UltraFine), eps=18.5, charge 0, multiplicity 2 -- only the starting geometry
# differs.
#
# Two separate PBS scripts (this one + submit_bplus_mid.pbs) -- see submit_bplus_mid.pbs's
# own comment for why (no sequencing dependency between the two, same one-job-per-qsub
# convention as every other staged deck this round).
#
# Walltime: MEASURED anchor -- the ORIGINAL bplus_reverse_last.gjf (same route, same job
# class) measured 8.04 core-h consumed (Job cpu time 8h2m6.3s) / 10.32 core-h reserved
# (Elapsed 9m40.6s x 64 cores, 78% efficiency) at 64 cores -- the RESERVED figure is the one
# a budget/scheduler cares about. 2h is a >12x margin over that measured elapsed time.
#
# Cores come from the deck's own %nprocshared=64 line -- no builder default.
# GAUSS_NPROCSHARED is NOT a Gaussian 16 variable and is deliberately absent here.
set -u
cd "${PBS_O_WORKDIR:-.}" || exit 1
trap 'echo "[sei] SIGTERM $(date -u +%FT%TZ): bplus_last killed before completion" >> bplus_last_kill.marker; exit 1' TERM
module load gaussian/g16.c01.linda 2>/dev/null || echo '[sei] module load gaussian/g16.c01.linda failed - continuing'
echo "[sei] bplus_last start $(date -u +%FT%TZ)"
g16 < bplus_reverse_last.gjf > bplus_reverse_last.log 2>&1
rc=$?
echo "[sei] bplus_last end $(date -u +%FT%TZ) rc=$rc"
exit $rc

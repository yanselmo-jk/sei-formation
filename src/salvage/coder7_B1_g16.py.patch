+def _balanced(s):
+    """Parentheses balance of a route fragment. None if there is nothing to check."""
+    if s is None:
+        return None
+    depth = 0
+    for ch in s:
+        if ch == "(":
+            depth += 1
+        elif ch == ")":
+            depth -= 1
+            if depth < 0:
+                return False
+    return depth == 0
+

#!/bin/sh
#PBS -V
{{PARTITION_LINE}}
#PBS -N {{JOB_NAME}}
{{ACCOUNT_LINE}}
{{RESOURCE_LINE}}
#PBS -l walltime={{WALL_HMS}}
{{STDOUT_LINE}}
{{STDERR_LINE}}
{{QOS_LINE}}
{{ARRAY_LINE}}
{{GPU_LINE}}
# sei_pilot_package — PBS/Torque 백엔드
#
# 🔴 이 형태는 **사용자가 이 클러스터에서 실제로 돌려온 스크립트**를 정본으로 삼아
#    맞춘 것이다. 이전 판은 필터 훅(`job_submit_filter`)에 4/4 거부됐다.
#    바꿀 때는 `tests/test_pbs_script_shape.py` 의 정본 비교를 함께 보라.
#    [UNVERIFIED — 사용자 클러스터에서만 확인 가능]
set -u

# [critic9 §5] 용매 정책의 env 주입 채널은 **테스트용**이다. `#PBS -V` 가 로그인 환경을
# 잡으로 들여오므로, 사이트 프로파일에 이 이름이 우연히/악의로 섞여 config 결정을
# 조용히 덮는 경로를 여기서 끊는다 — 잡 안에서 정책은 config 한 곳에서만 온다.
unset SEI_SOLVENT_POLICY_JSON 2>/dev/null || true
unset SEI_C8_ENDPOINTS_JSON 2>/dev/null || true
unset SEI_QC_MODREDUNDANT_FILE 2>/dev/null || true
# 🔴 [critic9 BLOCKER] SEI_QC_PURPOSE=smoke 가 제출 환경에서 상속되면 본계산
# payload 전부가 smoke 로 위장해 deck_verified 게이트를 통과한다 — 이 게이트는
# 미검증 덱에서 8,000+ core-h 를 지키는 유일한 것이다. 잡 시작 시 반드시 끊는다.
unset SEI_QC_PURPOSE 2>/dev/null || true

cd "${PBS_O_WORKDIR:-.}" || exit 1
{{MODULE_LINES}}
{{ENV_EXPORTS}}
export SEI_KEY="{{KEY}}"
export SEI_LOGICAL_KEY="{{LOGICAL_KEY}}"
export SEI_JOB_DIR="{{JOB_DIR}}"
export SEI_NODES="{{NODES}}"
export SEI_CORES_PER_NODE="{{CORES_PER_NODE}}"
export SEI_TOTAL_CORES="{{TOTAL_CORES}}"
export SEI_SCHEDULER="pbs"
export SEI_JOBID="${PBS_JOBID:-none}"

. "${SEI_PKG_ROOT}/payload/common.sh"
sei_job_main bash "{{CMD_FILE}}"
